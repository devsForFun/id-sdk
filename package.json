{
    "name": "@devsforfun/id-sdk",
    "version": "0.10.0",
    "description": "Typed Node SDK for devsforfun ID \u2014 auth, profile, entitlements, payments, app-to-app data sharing, AI agents, Google proxy, and webhooks.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "node ./scripts/check-publish-registry.mjs",
        "test": "vitest run",
        "openapi:types": "openapi-typescript openapi/devsforfun-id.public.openapi.json -o src/generated/openapi-types.ts"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/devsForFun/id-sdk.git"
    },
    "homepage": "https://devsforfun.app/developer",
    "bugs": {
        "url": "https://github.com/devsForFun/id-sdk/issues"
    },
    "keywords": [
        "devsforfun",
        "auth",
        "oauth",
        "identity",
        "sdk",
        "entitlements",
        "payments",
        "agents",
        "nextjs"
    ],
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.19.43",
        "tsup": "^8.3.0",
        "typescript": "^5",
        "vitest": "^4.1.5",
        "openapi-typescript": "^7.4.0"
    }
}
